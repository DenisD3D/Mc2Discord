root = true

# Gradle Kotlin scripts, formatted by ktlint (./gradlew spotlessApply)
[*.{kt,kts}]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160
ktlint_code_style = intellij_idea

# JSON, formatted by Gson (./gradlew spotlessApply) and VS Code
[*.{json,mcmeta}]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
